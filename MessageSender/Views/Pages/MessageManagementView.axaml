<UserControl
    x:Class="MessageSender.Views.Pages.MessageManagementView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
    xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m="using:MessageSender.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MessageSender.ViewModels.Pages"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MessageManagementViewModel"
    mc:Ignorable="d">
    <Border>
        <Grid ColumnDefinitions="300,1,*">
            <Grid Margin="0,0,3,0" RowDefinitions="Auto,*">
                <StackPanel
                    Margin="5"
                    Orientation="Horizontal"
                    Spacing="5">
                    <Button Classes="theme-soft accent" Command="{Binding AddMessageCommand}">Add new message</Button>
                    <Button
                        Classes="theme-soft danger"
                        Command="{Binding DeleteMessageCommand}"
                        IsEnabled="{Binding CanDelete}">
                        Delete
                    </Button>
                </StackPanel>
                <DataGrid
                    Grid.Row="1"
                    Margin="2,0,2,2"
                    AutoGenerateColumns="False"
                    BorderBrush="LightGray"
                    BorderThickness="0,0,0,0"
                    CanUserReorderColumns="True"
                    CanUserSortColumns="True"
                    GridLinesVisibility="None"
                    IsReadOnly="True"
                    ItemsSource="{Binding MessagesDataGrid}"
                    SelectedItem="{Binding SelectedMessage}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            x:DataType="m:StoredMessage"
                            Binding="{Binding Name}"
                            Header="Message name" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <GridSplitter
                Grid.Column="1"
                BorderBrush="LightGray"
                BorderThickness="1,0" />
            <Border Grid.Column="2">
                <Grid RowDefinitions="3*,1,2*">
                    <Border
                        Height="32"
                        Margin="0,0,15,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{actipro:ThemeResource Container2BackgroundBrush}"
                        BorderBrush="{actipro:ThemeResource Container2BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        ZIndex="10">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Width="32"
                                Padding="0"
                                Classes="theme-subtle"
                                Command="{Binding BeautifyCommand}"
                                IsEnabled="{Binding CanDelete}"
                                ToolTip.Tip="Beautify">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    Padding="0"
                                    FontSize="18"
                                    FontWeight="SemiBold">
                                    { }
                                </TextBlock>
                            </Button>
                            <!--  CDM view/edit toggle buttons  -->
                            <!--  Show when in CDM view mode: click to switch to raw edit  -->
                            <Button
                                Width="32"
                                Padding="0"
                                Classes="theme-subtle accent"
                                Command="{Binding ToggleCdmEditModeCommand}"
                                IsVisible="{Binding IsCdmViewMode}"
                                ToolTip.Tip="Edit raw JSON">
                                <PathIcon Data="{StaticResource EditRegular}" />
                            </Button>
                            <!--  Show when in CDM edit mode (raw): click to switch to CDM view  -->
                            <Button
                                Width="32"
                                Padding="0"
                                Classes="theme-subtle"
                                Command="{Binding ToggleCdmEditModeCommand}"
                                IsVisible="{Binding IsCdmEditActive}"
                                ToolTip.Tip="View CDM format">
                                <PathIcon Data="{StaticResource EyeRegular}" />
                            </Button>
                            <!--  Warning: CDM definitions not loaded  -->
                            <Path
                                Width="20"
                                Height="20"
                                Margin="-2,-1,0,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource WarningRegular}"
                                Fill="#DC3545"
                                IsVisible="{Binding ShouldShowCdmWarning}"
                                ToolTip.Tip="CDM definitions not loaded. Click the folder button to configure a path to a local copy of the cdm-definitions repository (https://github.com/resideo/cdm-definitions)." />
                        </StackPanel>
                    </Border>
                    <!--  Message Body: raw editor or CDM rendered view  -->
                    <Grid Grid.Row="0">
                        <avaloniaEdit:TextEditor
                            x:Name="MessageBodyEditor"
                            Margin="0"
                            Background="{actipro:ThemeResource Container1BackgroundBrush}"
                            Document="{Binding SelectedMessage.MessageBody}"
                            FontFamily="{StaticResource JetBrainsMono}"
                            IsEnabled="{Binding CanEditMessage}"
                            IsVisible="{Binding IsCdmViewMode, Converter={x:Static BoolConverters.Not}}" />
                        <!--  Read-only CDM human-readable view  -->
                        <avaloniaEdit:TextEditor
                            x:Name="CdmMessageBodyEditor"
                            Margin="0"
                            Background="{actipro:ThemeResource Container1BackgroundBrush}"
                            Document="{Binding CdmRenderedBody}"
                            FontFamily="{StaticResource JetBrainsMono}"
                            IsReadOnly="True"
                            IsVisible="{Binding IsCdmViewMode}" />
                    </Grid>
                    <GridSplitter
                        Grid.Row="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,1,0,0" />
                    <!--  Message Properties: raw editor or CDM rendered view  -->
                    <Grid Grid.Row="2">
                        <avaloniaEdit:TextEditor
                            x:Name="MessagePropertiesEditor"
                            Margin="0"
                            Background="{actipro:ThemeResource Container1BackgroundBrush}"
                            Document="{Binding SelectedMessage.UserProperties}"
                            FontFamily="{StaticResource JetBrainsMono}"
                            IsEnabled="{Binding CanEditMessage}"
                            IsVisible="{Binding IsCdmViewMode, Converter={x:Static BoolConverters.Not}}" />
                        <!--  Read-only CDM rendered properties view  -->
                        <avaloniaEdit:TextEditor
                            x:Name="CdmMessagePropertiesEditor"
                            Margin="0"
                            Background="{actipro:ThemeResource Container1BackgroundBrush}"
                            Document="{Binding CdmRenderedProperties}"
                            FontFamily="{StaticResource JetBrainsMono}"
                            IsReadOnly="True"
                            IsVisible="{Binding IsCdmViewMode}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
